# Copy this file to .env (it's git-ignored) and fill in the keys you have, then restart: npm start
# Each one switches on a feature; leave it empty and that feature simply stays hidden.
# On Render, set these in the dashboard instead (render.yaml marks them sync: false).

# ElevenLabs: Lazy's voice + gavel/snore sound effects. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: a different voice (default "Daniel", onwK4e9ZLuTAKqWW03F9) or model (default eleven_v3)
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=

# Sentry: traces of every Gemma call. Use a Browser JavaScript project's DSN.
SENTRY_DSN=

# TabPFN (Prior Labs): learns your personal laziness. https://ux.priorlabs.ai (API Keys)
TABPFN_TOKEN=
